# Copy to .env (git-ignored) and change the values. Used by docker-compose.yml.
# The *_DB_PASSWORD defaults below match application-local.yml, so the "local" profile works out of the box.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
MISSION_CONTROL_DB_PASSWORD=mission_control_dev
ROVER_DB_PASSWORD=rover_dev

# Full stack only (docker compose up). Generate each secret with:  openssl rand -base64 32
# JWT signing key (HS256), base64, at least 32 bytes.
REDLINK_JWT_SECRET=
# HMAC key shared by mission-control and rover-sim for the signed link packets, base64, at least 32 bytes.
REDLINK_LINK_SECRET=
# Password of the seeded demo users viewer / operator / director.
REDLINK_DEMO_USERS_PASSWORD=

# Optional demo knobs.
REDLINK_DSN_WINDOWS_ENABLED=false
REDLINK_ROVER_EVENTS_ENABLED=true
