# Lombok settings for the whole repository (conventions: AGENTS.md).
config.stopBubbling = true
# Mark generated code, so coverage tools and static analysis ignore it.
lombok.addLombokGeneratedAnnotation = true
# @Slf4j field name.
lombok.log.fieldName = log
# Setters and @Data on JPA entities would bypass the domain methods that guard invariants.
lombok.setter.flagUsage = warning
lombok.data.flagUsage = warning
